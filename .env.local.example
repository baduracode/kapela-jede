# ========================================================================
# KAPELA JEDE - Proměnné prostředí (Příklad)
# ========================================================================

# Supabase konfigurace (najdete v Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Mapy.cz REST API klíč (získejte zdarma na developer.mapy.cz)
MAPY_CZ_API_KEY=your_mapy_cz_api_key_here
NEXT_PUBLIC_MAPY_CZ_API_KEY=your_mapy_cz_api_key_here

# 4místný PIN pro zápis/editaci (výchozí: 1234)
NEXT_PUBLIC_APP_PIN=1234
